# Variáveis de ambiente e configurações locais
.env

# Ambientes virtuais Python
venv/
.venv/

# Cache e arquivos compilados do Python
__pycache__/
*.py[cod]

# Cache dos testes automatizados
.pytest_cache/

# Metadados de instalação do pacote Python
*.egg-info/

# Dependências e arquivos gerados pelo frontend
/dashboard/node_modules/
/dashboard/dist/
/dashboard/.vite/
*.tsbuildinfo

# Arquivos gerados pelos pipelines
/data/**/*

# Preserva a estrutura dos diretórios de dados
!/data/**/
!/data/**/.gitkeep